# Tencent CAPTCHA Configuration
# Get these values from: https://console.cloud.tencent.com/captcha

# Your Tencent CAPTCHA App ID
TENCENT_CAPTCHA_APP_ID=your_app_id_here

# Your Tencent CAPTCHA Secret Key
TENCENT_CAPTCHA_SECRET=your_secret_key_here

# Mock mode (set to "true" to bypass real CAPTCHA verification)
MOCK_CAPTCHA=false
